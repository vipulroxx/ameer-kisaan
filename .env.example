# Copy to .env (never commit .env). Generate the two secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"            -> JWT_SECRET
#   python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"  -> FIELD_ENCRYPTION_KEY
JWT_SECRET=
FIELD_ENCRYPTION_KEY=

# AI providers: ollama (local, default) | openai | azure_openai
LLM_PROVIDER=ollama
EMBEDDINGS_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text
# macOS: Docker has no GPU, so the in-Docker model is slow. For fast answers run Ollama on the Mac
# (brew install ollama && brew services start ollama && ollama pull llama3.2:3b && ollama pull nomic-embed-text),
# then uncomment these and set OLLAMA_MODEL=llama3.2:3b:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# LLM_TIMEOUT_SECONDS=60
# OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_CHAT_DEPLOYMENT=
# AZURE_OPENAI_EMBED_DEPLOYMENT=

LOG_LEVEL=INFO
